# ── Authentication ────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Database ──────────────────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgresql://timetrack:yourpassword@postgres:5432/employee_tracking

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── Seed user (optional) ──────────────────────────────────────────────────────
# Leave empty in production — users register via the app
# Only used on first startup if no users exist
SEED_EMAIL=
SEED_PASSWORD=
SEED_NAME=